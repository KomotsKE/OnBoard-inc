# Шаблон окружения. Скопируйте в .env — он в .gitignore и в репозиторий не попадает.
# Значения здесь нерабочие и годятся только для локальной разработки.
# Полный список и правила — §13 docs/conventions.md.

# ── База данных ───────────────────────────────────────────────────────────────
POSTGRES_USER=onboard
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=onboard
# Поменяйте, если 5432 уже занят локальным PostgreSQL.
POSTGRES_PORT=5432

# Строка подключения приложения. Внутри compose хост — имя сервиса postgres,
# при запуске бэкенда вне контейнера — localhost.
ONBOARD_DATABASE_URL=postgresql+psycopg://onboard:change-me-locally@postgres:5432/onboard

# Порт API на хосте
API_PORT=8000

# ── Стенд для проверки виджета ────────────────────────────────────────────────
TESTSITE_PORT=8080

# ── Секреты приложения (T0.3) ─────────────────────────────────────────────────
# Отсутствие любого из них останавливает старт приложения: подставлять дефолты
# в коде запрещено (§13 docs/conventions.md). Для локальной работы сгенерируйте:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ONBOARD_JWT_SECRET=replace-with-generated-value
ONBOARD_EDITOR_TOKEN_SECRET=replace-with-another-generated-value

# ── Адреса ────────────────────────────────────────────────────────────────────
# Подставляется в сниппет как data-api; при переезде на сервер меняется только здесь.
ONBOARD_PUBLIC_API_URL=http://localhost:8000
# Origin панели для CORS приватного контура.
ONBOARD_PANEL_ORIGIN=http://localhost:5173

# ── Прочее ────────────────────────────────────────────────────────────────────
ONBOARD_ENV=dev
ONBOARD_LOG_LEVEL=INFO
